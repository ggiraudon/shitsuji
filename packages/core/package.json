{
  "name": "@shitsuji/core",
  "version": "0.1.0",
  "description": "Shitsuji core: agent runtime, channels, persistence and model routing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shitsuji": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter @shitsuji/shared build && tsx watch src/index.ts",
    "start": "node dist/cli.js",
    "tui": "node dist/cli.js tui",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "^1.19.19",
    "@hono/node-ws": "^1.3.1",
    "@shitsuji/sandbox-protocol": "workspace:*",
    "@shitsuji/shared": "workspace:*",
    "dotenv": "^16.4.0",
    "grammy": "^1.46.0",
    "hono": "^4.0.0",
    "ink": "^5.0.0",
    "kysely": "^0.28.20",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "react": "^18.3.0",
    "yaml": "^2.9.1",
    "yargs": "^17.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.0",
    "@types/yargs": "^17.0.35",
    "ink-testing-library": "^4.0.0",
    "testcontainers": "^11.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "private": true,
  "files": [
    "dist",
    "migrations"
  ]
}
