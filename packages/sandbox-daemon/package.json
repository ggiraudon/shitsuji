{
  "name": "@shitsuji/sandbox-daemon",
  "version": "0.1.0",
  "private": true,
  "description": "sandboxd: the files API and (later) exec supervisor inside the sandbox container",
  "type": "module",
  "main": "./dist/main.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sandboxd": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@shitsuji/sandbox-protocol": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
