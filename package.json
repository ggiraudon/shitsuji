{
  "name": "shitsuji",
  "version": "0.1.0",
  "description": "A lightweight AI agent framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shitsuji": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "shitsuji",
    "tui": "shitsuji tui",
    "daemon": "shitsuji daemon",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.0",
    "hono": "^4.0.0",
    "ink": "^5.0.0",
    "react": "^18.3.0",
    "yargs": "^17.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/yargs": "^17.0.35",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.3.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
