{
  "name": "shitsuji-workspace",
  "private": true,
  "description": "Shitsuji: a proactive personal assistant with its own sandboxed computer",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p scripts/tsconfig.json",
    "test": "pnpm -r test && vitest run --root scripts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm check:imports && pnpm test",
    "check:imports": "tsx scripts/check-imports.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.1.9"
  }
}
