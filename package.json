{
  "name": "seahorse",
  "version": "0.1.0",
  "description": "A lightweight AI agent framework",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "seahorse": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "seahorse",
    "tui": "seahorse tui",
    "daemon": "seahorse daemon",
    "test": "vitest",
    "test:watch": "vitest watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "tui"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.0",
    "hono": "^4.0.0",
    "ink": "^5.0.0",
    "react": "^18.3.0",
    "yargs": "^17.7.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/yargs": "^17.0.35",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.15.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
