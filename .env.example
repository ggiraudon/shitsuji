# Copy to .env (never committed). Only composition/config/loadConfig.ts reads these.

# Model keys. Without a models section in shitsuji.config.yaml, the first key set picks the chat
# model: DeepSeek, then OpenAI, then Anthropic.
DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional overrides
# SHITSUJI_CONFIG=./shitsuji.config.yaml
# LOG_LEVEL=info              # debug | info | warn | error
# SHITSUJI_LOG_FORMAT=pretty  # pretty | json
# SHITSUJI_DATA_DIR=~/.shitsuji/data
# SHITSUJI_WEBHOOK_PORT=3000
# DATABASE_URL=postgres://shitsuji:shitsuji@localhost:5432/shitsuji

# Docker Compose
POSTGRES_PASSWORD=change-me

# SearXNG (web search). Any random string.
SEARXNG_SECRET=
# Telegram (F06). Get it from @BotFather; needed when channels.telegram.enabled is true.
# SHITSUJI_TELEGRAM_TOKEN=
# The TUI's owner key, when core runs in Docker (copy it from `docker compose logs core` at first
# start). Not needed when core runs on this machine: the TUI reads <dataDir>/owner.key.
# SHITSUJI_OWNER_KEY=
# For core running on the host with compose.dev.yaml:
# SHITSUJI_SEARXNG_URL=http://localhost:8888
