    "packages/core/src/application/context",
    "packages/core/src/application/modelCalls.ts",
    "packages/core/src/application/models",
    "packages/core/src/application/runtime",
    "packages/core/src/application/soul",
    "packages/core/src/application/tools",
    "packages/core/src/application/trust",
    "packages/core/src/adapters/auth",
    "packages/core/src/adapters/channels",
    "packages/core/src/adapters/clock",
    "packages/core/src/adapters/events",
    "packages/core/src/adapters/files",
    "packages/core/src/adapters/jobs",
    "packages/core/src/adapters/logging",
    "packages/core/src/adapters/memory",
